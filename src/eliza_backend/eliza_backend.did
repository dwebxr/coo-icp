type CanisterMetrics = record {
  stable_memory_pages : nat64;
  heap_memory_bytes : nat64;
  version : text;
  conversations : nat64;
};
type Character = record {
  bio : vec text;
  system_prompt : text;
  name : text;
  style : vec text;
};
type Config = record {
  admin : principal;
  llm_provider : LlmProvider;
  max_conversation_length : nat64;
};
type HttpHeader = record { value : text; name : text };
type HttpResponse = record {
  status : nat;
  body : blob;
  headers : vec HttpHeader;
};
type LlmProvider = variant { Fallback; OpenAI; OnChain };
type Message = record { content : text; role : text };
type Result = variant { Ok : text; Err : text };
type Result_1 = variant { Ok; Err : text };
type TransformArgs = record { context : blob; response : HttpResponse };
service : () -> {
  chat : (text) -> (Result);
  clear_conversation : () -> ();
  get_character : () -> (opt Character) query;
  get_config : () -> (opt Config) query;
  get_conversation_count : () -> (nat64) query;
  get_conversation_history : () -> (vec Message) query;
  get_metrics : () -> (CanisterMetrics) query;
  health : () -> (text) query;
  // Transfer admin rights to a new principal
  set_admin : (principal) -> (Result_1);
  set_llm_provider : (LlmProvider) -> (Result_1);
  store_encrypted_api_key : (blob) -> (Result_1);
  transform_openai_response : (TransformArgs) -> (HttpResponse) query;
  update_character : (Character) -> (Result_1);
  version : () -> (text) query;
}
