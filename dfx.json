{
  "version": 1,
  "canisters": {
    "eliza_backend": {
      "type": "rust",
      "package": "eliza_backend",
      "candid": "src/eliza_backend/eliza_backend.did",
      "metadata": [
        {
          "name": "candid:service"
        }
      ],
      "declarations": {
        "output": "src/eliza_frontend/src/declarations/generated",
        "bindings": [
          "js",
          "ts"
        ]
      }
    },
    "eliza_frontend": {
      "type": "assets",
      "source": [
        "src/eliza_frontend/dist"
      ],
      "dependencies": [
        "eliza_backend"
      ]
    },
    "internet_identity": {
      "type": "pull",
      "id": "rdmx6-jaaaa-aaaaa-aaadq-cai"
    }
  },
  "output_env_file": ".env",
  "networks": {
    "local": {
      "bind": "127.0.0.1:4943",
      "type": "ephemeral"
    },
    "ic": {
      "providers": [
        "https://ic0.app"
      ],
      "type": "persistent"
    }
  },
  "dfx": "0.30.2"
}
